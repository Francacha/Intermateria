PORT=3001

# Base de datos
# - Docker (PostgreSQL en contenedor): DB_HOST=db y DB_SSL=false
# - Vía web (Supabase):                DB_HOST=<host de Supabase> y DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=su_contraseña
DB_NAME=canchas
DB_SSL=false

# Nombre del droplet que se muestra en el pie de página del front
DROPLET=local

# Clave para firmar los tokens de sesión (texto largo y aleatorio)
JWT_SECRET=cambiar_por_un_texto_largo_y_aleatorio
