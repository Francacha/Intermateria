# Nombre que se ve en el pie de página del front: droplet-2 o droplet-3
DROPLET=droplet-2

# IP privada (VPC) de ESTE droplet: la API solo escucha acá
IP_PRIVADA=10.10.0.3

# IP privada del droplet 1 (donde está PostgreSQL)
IP_DROPLET1=10.10.0.2

# La misma contraseña que en el droplet 1
POSTGRES_PASSWORD=cambiar_esta_contraseña

# Base NoSQL vía web (MongoDB Atlas)
MONGO_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/

# Clave para firmar los tokens de sesión: LA MISMA en los 3 droplets
# (un token emitido por un droplet tiene que validar en los otros)
JWT_SECRET=cambiar_por_un_texto_largo_y_aleatorio
